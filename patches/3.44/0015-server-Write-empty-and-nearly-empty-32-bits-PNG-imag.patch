From 8da1b23a4bdc992d19575be2097af3c4f3a16c81 Mon Sep 17 00:00:00 2001
From: Michal Wloga <michal.wloga@envirosolutions.pl>
Date: Tue, 17 Nov 2026 09:45:18 +0100
Subject: [PATCH 15/15] [server] Write empty and nearly empty 32 bits PNG
 images with the run-length deflate strategy

With the low deflate level used for 32 bits PNG images, long runs of equal bytes take several times more room than with the default level: an empty transparent 1920x1080 image is written in 36 kB, where the PNG writer of Qt gives 8 kB. Maps of a single layer are often empty or nearly empty.

Images in which at most one pixel out of 200 breaks a run of equal bytes are now deflated with the run-length strategy of zlib, which stores such runs compactly and is as fast. One row out of 8 is examined, and the search stops as soon as the limit is passed. All other images are written as before, since the strategy makes them larger. The decoded pixels do not change.

Size of the file written for 1920x1080 transparent images, time of the PNG encoding alone: empty 36314 -> 8130 bytes (10.0 -> 10.4 ms); points with labels 37495 -> 9444 bytes; a few roads 46835 -> 16707 bytes. In 64 rendered maps of points, lines, polygons and filled areas, the 15 images under the limit became 41 to 78 % smaller and the others are unchanged.

diff --git a/src/server/services/wms/qgswmsutils.cpp b/src/server/services/wms/qgswmsutils.cpp
index bc6e65ec3d..829908917d 100644
--- a/src/server/services/wms/qgswmsutils.cpp
+++ b/src/server/services/wms/qgswmsutils.cpp
@@ -23,6 +23,7 @@
 
 #include <algorithm>
 #include <png.h>
+#include <zlib.h>
 
 #include "qgsmodule.h"
 #include "qgswmsutils.h"
@@ -72,6 +73,39 @@ namespace
     return flat * 3 < total ? PNG_FILTER_UP : PNG_FILTER_NONE;
   }
 
+  /**
+   * Returns TRUE if a 32 bits \a image is almost only made of runs of equal bytes, which
+   * is the case of an empty or nearly empty map, transparent or on a white or grey background.
+   *
+   * With a low deflate level such runs take several times more room than needed, unless
+   * the run-length strategy of zlib is used. That strategy gives larger files for any
+   * other content. One row out of 8 is examined.
+   */
+  bool pngMostlyRuns( const QImage &image, bool hasAlpha )
+  {
+    const int width = image.width();
+    const int height = image.height();
+    // the bytes written for a pixel: all of them, or the colors only
+    const QRgb mask = hasAlpha ? 0xffffffffu : 0x00ffffffu;
+    const QRgb ones = hasAlpha ? 0x01010101u : 0x00010101u;
+    // with more than one pixel out of 200 breaking a run, the default strategy does as well
+    const qint64 maxBreaks = static_cast<qint64>( width ) * ( ( height + 7 ) / 8 ) / 200;
+    qint64 breaks = 0;
+    for ( int y = 0; y < height; y += 8 )
+    {
+      const QRgb *row = reinterpret_cast<const QRgb *>( image.constScanLine( y ) );
+      for ( int x = 0; x < width; ++x )
+      {
+        const QRgb pixel = row[x] & mask;
+        if ( pixel != ( pixel & 0xff ) * ones || ( x > 0 && pixel != ( row[x - 1] & mask ) ) )
+          ++breaks;
+      }
+      if ( breaks > maxBreaks )
+        return false;
+    }
+    return true;
+  }
+
   /**
    * Writes a 32 bits \a image as PNG to \a device, with a single row filter and
    * a low deflate level.
@@ -125,6 +159,8 @@ namespace
 
     png_set_write_fn( png, device, pngWriteCallback, pngFlushCallback );
     png_set_compression_level( png, 2 );
+    if ( rowFilter == PNG_FILTER_NONE && pngMostlyRuns( image, hasAlpha ) )
+      png_set_compression_strategy( png, Z_RLE );
     png_set_filter( png, PNG_FILTER_TYPE_BASE, rowFilter );
     png_set_IHDR( png, info, static_cast<png_uint_32>( image.width() ), static_cast<png_uint_32>( image.height() ), 8, hasAlpha ? PNG_COLOR_TYPE_RGB_ALPHA : PNG_COLOR_TYPE_RGB, PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT );
     if ( image.dotsPerMeterX() > 0 || image.dotsPerMeterY() > 0 )
