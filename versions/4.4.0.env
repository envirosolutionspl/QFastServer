QGIS_VERSION=4.4.0
QGIS_TAG=final-4_4_0
SERIES=4.4
BUILD_IMAGE=qgis/qgis3-build-deps-ubuntu-qt6:release-4_4
BASE_IMAGE=qgis/qgis-server:4.4.0-resolute
BUILD_PACKAGES=libtbb-dev libmeshoptimizer-dev nlohmann-json3-dev
SERIES_CMAKE_OPTIONS=-DQT_PLUGINS_DIR=lib/x86_64-linux-gnu/qt6/plugins -DWITH_INTERNAL_SPATIALINDEX=TRUE -DWITH_INTERNAL_NLOHMANN_JSON=OFF -DWITH_INTERNAL_MESHOPTIMIZER=FALSE -DWITH_INTERNAL_QWT=TRUE -DWITH_SFCGAL=TRUE -DWITH_GEOGRAPHICLIB=TRUE -DWITH_PDF4QT=TRUE -DWITH_INTERNAL_BLEND2D=TRUE -DWITH_TBB=TRUE
